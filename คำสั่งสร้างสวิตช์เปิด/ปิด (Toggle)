-- ตัวแปรสำหรับเก็บสถานะ
local isAutoFarmOn = false

FarmSection:NewToggle("Auto Farm", "เปิด/ปิดระบบฟาร์มอัตโนมัติ", function(state)
    isAutoFarmOn = state
    if state then
        print("เปิดระบบฟาร์ม")
        Window:Notify("Auto Farm", "เริ่มทำงานแล้ว", "info")
    else
        print("ปิดระบบฟาร์ม")
        Window:Notify("Auto Farm", "หยุดทำงานแล้ว", "warn")
    end
end)
