-- เปลี่ยนข้อความสถานะมุมซ้ายล่าง
Window:SetStatus("กำลังฟาร์ม...")

-- เปลี่ยนตัวเลข "รอบ: 0" มุมขวาล่าง
Window:SetRound(15)

-- เปลี่ยนตัวเลข "00:00" มุมขวาล่าง (เวลา)
Window:SetTime("01:25")

-- ส่งแจ้งเตือน (Toast) มุมขวาบน
-- kind ที่ใช้ได้: "info" (สีแดง), "ok" (สีเขียว), "warn" (สีเหลือง), "err" (สีแดงเข้ม)
Window:Notify("หัวข้อ", "ข้อความแจ้งเตือน", "ok", 3.5)
